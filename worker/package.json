{
  "name": "maestrale-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend Maestrale su Cloudflare Workers (Hono + Workers KV)",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run && vitest run -c vitest.admin.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "test:worker": "vitest run",
    "test:admin": "vitest run -c vitest.admin.config.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  }
}
