{
  // Worker separato del backoffice (ADR-0007): origine propria, SSR, Cloudflare
  // Access. Nessun binding HISTORY né Open-Meteo: qui si toccano solo catalogo,
  // registri e cache del catalogo.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maestrale-admin",
  "main": "src/admin/index.tsx",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "routes": [
    // Custom domain del backoffice: wrangler crea il record DNS e il certificato.
    { "pattern": "admin.gyuco.win", "custom_domain": true }
  ],
  "kv_namespaces": [
    {
      "binding": "FORECASTS",
      "id": "7b1c0444535542408cc05fa9dd59536b",
      "preview_id": "b6b83416188441aea18ce2846ccad5d6"
    }
  ],
  "d1_databases": [
    {
      "binding": "CORE",
      "database_name": "maestrale-core",
      "database_id": "47558a36-70cb-46d2-9133-a143dc1cd8cb",
      "migrations_dir": "migrations-core"
    }
  ],
  "vars": {
    "ADMIN_ORIGIN": "https://admin.gyuco.win",
    "ACCESS_TEAM_DOMAIN": "https://purple-poetry-ead0.cloudflareaccess.com",
    "ACCESS_AUD": "1bae5e74843b0ff0553f968817a1295c63ef4fdd4b7a8afffc92670d1016cbb1"
  }
}
